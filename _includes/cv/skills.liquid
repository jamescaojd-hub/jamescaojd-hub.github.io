{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="skill-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      {% assign plain_skills_row = entry.name == 'Skills' and entry.level == nil %}
      {% if plain_skills_row %}
        {% for keyword in entry.keywords %}
          {% if forloop.last %}
            {{ keyword }}
          {% else %}
            {{ keyword }},
          {% endif %}
        {% endfor %}
      {% else %}
        <strong>
          {{- entry.name -}}
          {%- if entry.level %} ({{ entry.level }}){% endif %}:</strong
        >
        {% if entry.keywords %}
          {% for keyword in entry.keywords %}
            {% if forloop.last %}
              {{ keyword }}
            {% else %}
              {{ keyword }},
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .skill-item {
    padding: 0.5rem 0;
  }
</style>
